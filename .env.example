# StarzLink environment — copy to .env.local and fill in real values.
# NEVER commit .env.local. Rotate any key that ends up in git history.

# ── Groq (AI features) ────────────────────────────────────────────────────
# Also readable at runtime from the InsForge `settings` table (key: groq_api_key).
GROQ_API_KEY=

# ── LinkedIn OAuth ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Facebook OAuth ────────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── App URL (update per environment) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (hosted Checkout) ──────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com — sk_test_… for dev.
STRIPE_SECRET_KEY=
# From your webhook endpoint (or `stripe listen`) — starts with whsec_
STRIPE_WEBHOOK_SECRET=
